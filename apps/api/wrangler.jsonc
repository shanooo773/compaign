{
  "name": "ms-professor-outreach-api",
  "main": "src/index.ts",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-10-01",
  "vars": {
    "APP_ORIGIN": "https://ms-professor-agent-malang43.vercel.app",
    "OAUTH_ENABLED": "true",
    "LIVE_EMAIL_ENABLED": "false",
    "MOCK_DELIVERY_ENABLED": "false",
    "AI_PROVIDER": "mock",
    "GROQ_FREE_PLAN_CONFIRMED": "false",
    "MAIL_PROVIDER": "disabled",
    "MAIL_DELIVERY_ENABLED": "false",
    "MAIL_FREE_PLAN_CONFIRMED": "false",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "outreach",
      "database_id": "684cb48c-3f43-4cef-8217-cf9624d23522",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [
    { "binding": "DOCUMENTS_KV", "id": "522d30d6935741b0b659d92b3136ec8c" },
  ],
  "triggers": { "crons": ["* * * * *"] },
  "observability": {
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
  },
  "env": {
    "local": {
      "name": "ms-professor-outreach-api-local",
      "vars": {
        "APP_ORIGIN": "http://localhost:3000",
        "OAUTH_ENABLED": "false",
        "LIVE_EMAIL_ENABLED": "false",
        "AI_PROVIDER": "mock",
        "GROQ_FREE_PLAN_CONFIRMED": "false",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "outreach",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
      "kv_namespaces": [
        { "binding": "DOCUMENTS_KV", "id": "00000000000000000000000000000000" },
      ],
      "r2_buckets": [
        { "binding": "DOCUMENTS", "bucket_name": "outreach-private" },
      ],
    },
  },
}
